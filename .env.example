# Copy this file to .env.local and fill in the values. .env.local is gitignored;
# this file is committed so the required names are discoverable.
#
# Both tokens come from https://account.mapbox.com/access-tokens/

# The Default Public Token, starting with "pk.". Read by the app at runtime to
# fetch map tiles. The EXPO_PUBLIC_ prefix is what makes Expo expose it to the
# bundle — without the prefix the app cannot see it. Public tokens are meant to
# ship inside client apps; this one is not a secret.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# The published Mapbox style the map renders with, as
# mapbox://styles/<username>/<style-id>. Produced by uploading
# map-style/unmapp-cream.json in Mapbox Studio and pressing Publish. Not a
# secret — it lives here rather than in the source so that pointing the app at a
# different style (a draft, a dark variant) is a config change, not a commit.
# Leave it empty and the app falls back to a stock Mapbox style and says so.
EXPO_PUBLIC_MAPBOX_STYLE_URL=

# A token created with the DOWNLOADS:READ scope, starting with "sk.". Used only
# while building, to download Mapbox's native SDK, and deliberately without the
# EXPO_PUBLIC_ prefix so it never reaches the bundle. This one IS a secret.
# Leave empty first: recent Mapbox SDK versions no longer require it. Fill it in
# only if the iOS build fails with a 401 or 403 while downloading the SDK.
MAPBOX_DOWNLOAD_TOKEN=
